{
  "name": "fractal",
  "displayName": "Fractal Note — Markdown, Outliner, Database, Mindmap & Files",
  "description": "WYSIWYG markdown editor + outliner with Database & Mindmap modes, and all your files in one place — full-text search reaches inside attached PDF / Word / Excel / PowerPoint and text files (HTML, JSON, …)",
  "version": "1.4.2-rc.7",
  "publisher": "imaken",
  "author": "imaken",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raggbal/fractal"
  },
  "bugs": {
    "url": "https://github.com/raggbal/fractal/issues"
  },
  "homepage": "https://raggbal.github.io/fractal/",
  "sponsor": {
    "url": "https://github.com/sponsors/raggbal"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "outliner",
    "notebook",
    "note",
    "mermaid",
    "table",
    "dynalist",
    "typora",
    "fractal note",
    "mindmap",
    "mind map",
    "notes",
    "note-taking",
    "knowledge base",
    "database",
    "daily notes",
    "task",
    "notion",
    "obsidian",
    "drawio",
    "pdf",
    "pdf search",
    "full text search",
    "document search",
    "file attachment",
    "attachments",
    "file manager",
    "office"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fractal-notes",
          "title": "Fractal Note",
          "icon": "media/notes-icon.svg"
        }
      ]
    },
    "views": {
      "fractal-notes": [
        {
          "id": "notesLists",
          "name": "Fractal List"
        },
        {
          "id": "notesExplorer",
          "name": "Notes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "notesLists",
        "contents": "Add an existing .fractal, or create a new one.\n[Add Existing .fractal](command:fractal.openNotesRegistry)\n[Create New .fractal](command:fractal.createNotesRegistry)"
      },
      {
        "view": "notesExplorer",
        "contents": "Choose or create a .fractal in Fractal List above.",
        "when": "!fractal.hasNotesRegistry"
      },
      {
        "view": "notesExplorer",
        "contents": "This .fractal has no notes yet. A note is a folder.\n[New Note](command:fractal.newNote)\n[Add Existing Note Folder](command:fractal.addNotesFolder)",
        "when": "fractal.hasNotesRegistry"
      }
    ],
    "commands": [
      {
        "command": "fractal.openEditor",
        "title": "Open with Fractal Editor",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.newNote",
        "title": "New Note…",
        "category": "Fractal Note",
        "icon": "$(new-folder)"
      },
      {
        "command": "fractal.addNotesFolder",
        "title": "Add Existing Note Folder…",
        "category": "Fractal Note",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fractal.revealNotesFolder",
        "title": "Reveal in Finder / Explorer",
        "category": "Fractal Note",
        "icon": "$(go-to-file)"
      },
      {
        "command": "fractal.revealNotesRegistry",
        "title": "Reveal in Finder / Explorer",
        "category": "Fractal Note",
        "icon": "$(go-to-file)"
      },
      {
        "command": "fractal.activateNotesRegistry",
        "title": "Switch to This .fractal",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.switchNotesRegistry",
        "title": "Switch .fractal…",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.openNotesRegistry",
        "title": "Add Existing .fractal…",
        "category": "Fractal Note",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fractal.createNotesRegistry",
        "title": "Create New .fractal…",
        "category": "Fractal Note",
        "icon": "$(new-file)"
      },
      {
        "command": "fractal.removeNotesRegistry",
        "title": "Remove from Fractal List (keeps the file)",
        "category": "Fractal Note",
        "icon": "$(close)"
      },
      {
        "command": "fractal.removeNotesFolder",
        "title": "Remove from Notes (keeps the folder)",
        "category": "Fractal Note",
        "icon": "$(close)"
      },
      {
        "command": "fractal.openNotesFolder",
        "title": "Open Notes Folder",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.migrateToFlatLayout",
        "title": "Migrate to Flat Layout",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.exportToPdf",
        "title": "Export to PDF",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.insertTable",
        "title": "Insert Table",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.insertToc",
        "title": "Insert Table of Contents",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.openAsText",
        "title": "Open as Text Editor",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.toggleSourceMode",
        "title": "Toggle Source Mode",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.compareAsText",
        "title": "Compare as Text",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.undo",
        "title": "Undo",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.redo",
        "title": "Redo",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.scopeIn",
        "title": "Scope Into Node",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.scopeOut",
        "title": "Clear Scope",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.newOutliner",
        "title": "New Outliner File",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.cleanUnusedFilesInNote",
        "title": "Clean Unused Files in All Notes",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.cleanUnusedFilesInCurrentNote",
        "title": "Clean Unused Files in Current Note",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.translate",
        "title": "Translate",
        "category": "Fractal Note"
      },
      {
        "command": "fractal.toggleSidebar",
        "title": "Toggle Right Sidebar (Outline / SidePanel)",
        "category": "Fractal Note"
      }
    ],
    "customEditors": [
      {
        "viewType": "fractal.editor",
        "displayName": "Fractal Note",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "fractal.outliner",
        "displayName": "Fractal Note Outliner",
        "selector": [
          {
            "filenamePattern": "*.out"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "fractal.fileViewer",
        "displayName": "Fractal File Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "fractal.fileViewerHtml",
        "displayName": "Fractal File Viewer",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "fractal.fileViewerOffice",
        "displayName": "Fractal File Viewer",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "fractal.fileViewerText",
        "displayName": "Fractal File Viewer",
        "selector": [
          {
            "filenamePattern": "*.txt"
          },
          {
            "filenamePattern": "*.log"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.xml"
          },
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.js"
          },
          {
            "filenamePattern": "*.mjs"
          },
          {
            "filenamePattern": "*.cjs"
          },
          {
            "filenamePattern": "*.ts"
          },
          {
            "filenamePattern": "*.tsx"
          },
          {
            "filenamePattern": "*.jsx"
          },
          {
            "filenamePattern": "*.py"
          },
          {
            "filenamePattern": "*.rb"
          },
          {
            "filenamePattern": "*.go"
          },
          {
            "filenamePattern": "*.rs"
          },
          {
            "filenamePattern": "*.java"
          },
          {
            "filenamePattern": "*.c"
          },
          {
            "filenamePattern": "*.h"
          },
          {
            "filenamePattern": "*.cpp"
          },
          {
            "filenamePattern": "*.hpp"
          },
          {
            "filenamePattern": "*.cs"
          },
          {
            "filenamePattern": "*.sh"
          },
          {
            "filenamePattern": "*.sql"
          },
          {
            "filenamePattern": "*.ini"
          },
          {
            "filenamePattern": "*.toml"
          },
          {
            "filenamePattern": "*.conf"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "fractal.fileViewerImage",
        "displayName": "Fractal File Viewer",
        "selector": [
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.gif"
          },
          {
            "filenamePattern": "*.webp"
          },
          {
            "filenamePattern": "*.avif"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.ico"
          },
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "fractal.fileViewerDrawio",
        "displayName": "Fractal File Viewer",
        "selector": [
          {
            "filenamePattern": "*.drawio"
          },
          {
            "filenamePattern": "*.dio"
          },
          {
            "filenamePattern": "*.drawio.svg"
          },
          {
            "filenamePattern": "*.dio.svg"
          },
          {
            "filenamePattern": "*.drawio.png"
          },
          {
            "filenamePattern": "*.dio.png"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": [
      {
        "id": "fractal.display",
        "title": "%config.category.display%",
        "order": 1,
        "properties": {
          "fractal.theme": {
            "title": "%config.theme.title%",
            "type": "string",
            "enum": [
              "auto",
              "light",
              "dark"
            ],
            "enumItemLabels": [
              "%config.enum.theme.auto%",
              "%config.enum.theme.light%",
              "%config.enum.theme.dark%"
            ],
            "default": "auto",
            "description": "%config.theme.description%",
            "order": 1
          },
          "fractal.language": {
            "title": "%config.language.title%",
            "type": "string",
            "enum": [
              "default",
              "en",
              "ja",
              "zh-TW",
              "zh-CN",
              "ko",
              "es",
              "fr"
            ],
            "enumItemLabels": [
              "%config.enum.language.default%",
              "English",
              "日本語",
              "繁體中文",
              "简体中文",
              "한국어",
              "Español",
              "Français"
            ],
            "default": "default",
            "description": "%config.language.description%",
            "order": 2
          },
          "fractal.fontSize": {
            "title": "%config.fontSize.title%",
            "type": "number",
            "default": 12,
            "minimum": 8,
            "maximum": 40,
            "description": "%config.fontSize.description%",
            "order": 3
          },
          "fractal.imageMaxWidth": {
            "title": "%config.imageMaxWidth.title%",
            "type": "number",
            "default": 400,
            "minimum": 50,
            "maximum": 4000,
            "description": "%config.imageMaxWidth.description%",
            "order": 4
          },
          "fractal.toolbarMode": {
            "title": "%config.toolbarMode.title%",
            "type": "string",
            "enum": [
              "simple",
              "full"
            ],
            "enumItemLabels": [
              "%config.enum.toolbarMode.simple%",
              "%config.enum.toolbarMode.full%"
            ],
            "default": "simple",
            "description": "%config.toolbarMode.description%",
            "order": 5
          },
          "fractal.showTranslateButtons": {
            "title": "%config.showTranslateButtons.title%",
            "type": "boolean",
            "default": false,
            "description": "%config.showTranslateButtons.description%",
            "order": 6
          },
          "fractal.showOpenInTextEditor": {
            "title": "%config.showOpenInTextEditor.title%",
            "type": "boolean",
            "default": true,
            "description": "%config.showOpenInTextEditor.description%",
            "order": 7
          }
        }
      },
      {
        "id": "fractal.files",
        "title": "%config.category.files%",
        "order": 2,
        "properties": {
          "fractal.resourceRoots": {
            "title": "%config.resourceRoots.title%",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.resourceRoots.description%",
            "order": 1
          },
          "fractal.viewerHtmlAllowScripts": {
            "title": "%config.viewerHtmlAllowScripts.title%",
            "type": "boolean",
            "default": true,
            "description": "%config.viewerHtmlAllowScripts.description%",
            "order": 2
          }
        }
      },
      {
        "id": "fractal.pdf",
        "title": "%config.category.pdf%",
        "order": 3,
        "properties": {
          "fractal.pdfBrowserPath": {
            "title": "%config.pdfBrowserPath.title%",
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "%config.pdfBrowserPath.description%",
            "order": 1
          },
          "fractal.pdfStyles": {
            "title": "%config.pdfStyles.title%",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.pdfStyles.description%",
            "order": 2
          },
          "fractal.pdfIncludeDefaultStyles": {
            "type": "boolean",
            "default": true,
            "description": "%config.deprecated.pdfIncludeDefaultStyles%",
            "deprecationMessage": "%config.deprecated.pdfIncludeDefaultStyles%"
          }
        }
      },
      {
        "id": "fractal.aws",
        "title": "%config.category.aws%",
        "order": 4,
        "properties": {
          "fractal.awsAccessKeyId": {
            "title": "%config.awsAccessKeyId.title%",
            "type": "string",
            "default": "",
            "description": "%config.awsAccessKeyId.description%",
            "order": 1
          },
          "fractal.awsSecretAccessKey": {
            "title": "%config.awsSecretAccessKey.title%",
            "type": "string",
            "default": "",
            "description": "%config.awsSecretAccessKey.description%",
            "order": 2
          },
          "fractal.awsRegion": {
            "title": "%config.awsRegion.title%",
            "type": "string",
            "default": "",
            "description": "%config.awsRegion.description%",
            "order": 3
          },
          "fractal.translateTerminology": {
            "title": "%config.translateTerminology.title%",
            "type": "string",
            "default": "",
            "description": "%config.translateTerminology.description%",
            "order": 4
          },
          "fractal.s3AccessKeyId": {
            "type": "string",
            "default": "",
            "description": "%config.deprecated.aws%",
            "deprecationMessage": "%config.deprecated.aws%"
          },
          "fractal.s3SecretAccessKey": {
            "type": "string",
            "default": "",
            "description": "%config.deprecated.aws%",
            "deprecationMessage": "%config.deprecated.aws%"
          },
          "fractal.s3Region": {
            "type": "string",
            "default": "us-east-1",
            "description": "%config.deprecated.aws%",
            "deprecationMessage": "%config.deprecated.aws%"
          },
          "fractal.transAccessKeyId": {
            "type": "string",
            "default": "",
            "description": "%config.deprecated.aws%",
            "deprecationMessage": "%config.deprecated.aws%"
          },
          "fractal.transSecretAccessKey": {
            "type": "string",
            "default": "",
            "description": "%config.deprecated.aws%",
            "deprecationMessage": "%config.deprecated.aws%"
          },
          "fractal.transRegion": {
            "type": "string",
            "default": "us-east-1",
            "description": "%config.deprecated.aws%",
            "deprecationMessage": "%config.deprecated.aws%"
          },
          "fractal.translateSourceLang": {
            "type": "string",
            "default": "en",
            "description": "%config.deprecated.translateLangs%",
            "deprecationMessage": "%config.deprecated.translateLangs%"
          },
          "fractal.translateTargetLang": {
            "type": "string",
            "default": "ja",
            "description": "%config.deprecated.translateLangs%",
            "deprecationMessage": "%config.deprecated.translateLangs%"
          },
          "fractal.translateTerminologyFile": {
            "type": "string",
            "default": "",
            "description": "%config.deprecated.terminology%",
            "deprecationMessage": "%config.deprecated.terminology%"
          },
          "fractal.translateTerminologyName": {
            "type": "string",
            "default": "",
            "description": "%config.deprecated.terminology%",
            "deprecationMessage": "%config.deprecated.terminology%"
          }
        }
      },
      {
        "id": "fractal.advanced",
        "title": "%config.category.advanced%",
        "order": 5,
        "properties": {
          "fractal.enableDebugLogging": {
            "title": "%config.enableDebugLogging.title%",
            "type": "boolean",
            "default": false,
            "description": "%config.enableDebugLogging.description%",
            "order": 1
          }
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fractal.insertTable",
          "when": "resourceLangId == markdown",
          "group": "fractal"
        },
        {
          "command": "fractal.insertToc",
          "when": "resourceLangId == markdown",
          "group": "fractal"
        }
      ],
      "explorer/context": [
        {
          "command": "fractal.openAsText",
          "when": "resourceLangId == markdown",
          "group": "navigation@99"
        },
        {
          "command": "fractal.compareAsText",
          "when": "resourceLangId == markdown",
          "group": "3_compare"
        }
      ],
      "editor/title/context": [
        {
          "command": "fractal.openAsText",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "fractal.activateNotesRegistry",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "fractal.createNotesRegistry",
          "when": "view == notesLists",
          "group": "navigation@1"
        },
        {
          "command": "fractal.openNotesRegistry",
          "when": "view == notesLists",
          "group": "navigation@2"
        },
        {
          "command": "fractal.newNote",
          "when": "view == notesExplorer && fractal.hasNotesRegistry",
          "group": "navigation@1"
        },
        {
          "command": "fractal.addNotesFolder",
          "when": "view == notesExplorer && fractal.hasNotesRegistry",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "fractal.revealNotesRegistry",
          "when": "view == notesLists && viewItem == notesList",
          "group": "inline@1"
        },
        {
          "command": "fractal.removeNotesRegistry",
          "when": "view == notesLists && viewItem == notesList",
          "group": "inline@2"
        },
        {
          "command": "fractal.revealNotesFolder",
          "when": "view == notesExplorer && viewItem == notesFolder",
          "group": "inline@1"
        },
        {
          "command": "fractal.removeNotesFolder",
          "when": "view == notesExplorer && viewItem == notesFolder",
          "group": "inline@2"
        },
        {
          "command": "fractal.migrateToFlatLayout",
          "when": "view == notesExplorer && viewItem == notesFolder",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fractal.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'fractal.editor'"
      },
      {
        "command": "fractal.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "(activeCustomEditorId == 'fractal.editor' || activeCustomEditorId == 'fractal.outliner') && !editorTextFocus"
      },
      {
        "command": "fractal.redo",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "(activeCustomEditorId == 'fractal.editor' || activeCustomEditorId == 'fractal.outliner') && !editorTextFocus"
      },
      {
        "command": "fractal.toggleSourceMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "activeCustomEditorId == 'fractal.editor'"
      },
      {
        "command": "fractal.openAsText",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "activeCustomEditorId == 'fractal.editor'"
      },
      {
        "command": "fractal.scopeOut",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeCustomEditorId == 'fractal.outliner'"
      },
      {
        "command": "fractal.scopeIn",
        "key": "ctrl+]",
        "mac": "cmd+]",
        "when": "activeCustomEditorId == 'fractal.outliner'"
      },
      {
        "command": "fractal.translate",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeCustomEditorId == 'fractal.editor'"
      },
      {
        "command": "fractal.toggleSidebar",
        "key": "ctrl+\\",
        "mac": "cmd+\\",
        "when": "activeCustomEditorId == 'fractal.editor' || activeCustomEditorId == 'fractal.outliner' || activeWebviewPanelId == 'fractal.notes'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ --noEmit && tsc -p tsconfig.shared-emit.json && node agent-capability/server-src/build.mjs && node esbuild.js && node build-locales.js && node scripts/copy-webview.js && node scripts/copy-vendor.js && node scripts/build-pdfjs-viewer.js && node scripts/verify-drawio-vendor.js && node scripts/build-viewer-modules.js",
    "build:pdfjs-vendor": "node scripts/build-pdfjs-vendor.js",
    "build:mcp": "node agent-capability/server-src/build.mjs",
    "watch": "node esbuild.js --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "test:build": "node test/build-standalone.js",
    "test:build:all": "node test/build-standalone.js && node test/build-standalone-outliner.js && node test/build-standalone-notes.js && node scripts/build-pdfjs-viewer.js && node scripts/build-viewer-modules.js && node test/build-standalone-viewer.js",
    "test:e2e": "npm run test:build && playwright test",
    "test:e2e:ui": "npm run test:build && playwright test --ui",
    "test:serve": "npx serve test/html -p 3000",
    "test:parallel": "bash test/run-parallel-tests.sh",
    "test": "npm run test:parallel",
    "build:locales": "node build-locales.js",
    "shots": "npm run shots:readme && npm run shots:site",
    "shots:readme": "playwright test -c screenshots readme",
    "shots:site": "cd electron && npm run compile && cd .. && playwright test -c screenshots site"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chokidar": "^4.0.3",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.55.0",
    "jsdom": "^27.4.0",
    "jsonc-parser": "^3.3.1",
    "pdfjs-viewer-dist": "npm:pdfjs-dist@5.5.207",
    "serve": "^14.2.5",
    "typescript": "^5.3.0",
    "vscode-uri": "^3.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-translate": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "katex": "^0.16.9",
    "mermaid": "^10.6.0",
    "pdfjs-dist": "4.10.38",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "@napi-rs/canvas": "file:./scripts/empty-stub"
  }
}
