{
  "name": "fractal-desktop",
  "version": "0.195.607",
  "private": true,
  "description": "Fractal Notes for desktop — runs the VS Code extension's own Notes code on a vscode API shim (ADR-0013)",
  "main": "out/main/main.js",
  "author": {
    "name": "imaken",
    "email": "imaken@users.noreply.github.com"
  },
  "homepage": "https://raggbal.github.io/fractal/",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "build:shim": "npm run clean && tsc -p . && tsc -p tsconfig.renderer.json",
    "compile": "cd .. && npm run compile && cd electron && npm run build:shim",
    "build:app-dir": "npm run compile && security unlock-keychain -p \"$(cat ~/.fractal-signing/keychain-password)\" ~/Library/Keychains/fractal-signing.keychain-db && ELECTRON_RUN_AS_NODE= CSC_KEYCHAIN=~/Library/Keychains/fractal-signing.keychain-db electron-builder --dir --config electron-builder.config.js",
    "build:mac": "bash scripts/build-mac.sh",
    "build:e2e": "npm run compile && npm run pack:e2e",
    "pack:e2e": "ELECTRON_RUN_AS_NODE= electron-builder --dir --config electron-builder.e2e.config.js",
    "start": "npm run compile && ELECTRON_RUN_AS_NODE= electron .",
    "start:fast": "npm run build:shim && ELECTRON_RUN_AS_NODE= electron .",
    "test:e2e": "npm run build:app-dir && npm run pack:e2e && cd .. && npx playwright test test/e2e-electron-app"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "com.imaken.fractal",
    "productName": "Fractal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../out",
        "to": "ext/out",
        "filter": [
          "**/*",
          "!**/*.map",
          "!__bundle-smoke-messages.js"
        ]
      },
      {
        "from": "../media",
        "to": "ext/media"
      },
      {
        "from": "../vendor",
        "to": "ext/vendor"
      },
      {
        "from": "../package.json",
        "to": "ext/package.json"
      },
      {
        "from": "../package.nls.json",
        "to": "ext/package.nls.json"
      },
      {
        "from": "../package.nls.ja.json",
        "to": "ext/package.nls.ja.json"
      },
      {
        "from": "../package.nls.es.json",
        "to": "ext/package.nls.es.json"
      },
      {
        "from": "../package.nls.fr.json",
        "to": "ext/package.nls.fr.json"
      },
      {
        "from": "../package.nls.ko.json",
        "to": "ext/package.nls.ko.json"
      },
      {
        "from": "../package.nls.zh-cn.json",
        "to": "ext/package.nls.zh-cn.json"
      },
      {
        "from": "../package.nls.zh-tw.json",
        "to": "ext/package.nls.zh-tw.json"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "kensuke imaizumi (TBCWF5T26D)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": true,
      "artifactName": "Fractal-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
