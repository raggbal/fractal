<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the hardened-runtime build (electron/package.json build.mac, app and helpers).
  The hardened runtime keeps other local processes from loading their code into Fractal
  (DYLD_INSERT_LIBRARIES and friends are ignored; Electron's fuses cover ELECTRON_RUN_AS_NODE,
  NODE_OPTIONS and inspect). Only what Electron needs is allowed:
  - allow-jit / allow-unsigned-executable-memory: V8 and WebAssembly
  - disable-library-validation: the ad-hoc signed frameworks and helpers carry no Team ID
  com.apple.security.cs.allow-dyld-environment-variables is deliberately absent.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
