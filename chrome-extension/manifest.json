{
  "manifest_version": 3,
  "name": "Fractal Web Clipper",
  "version": "0.2.0",
  "description": "Clip the current web page into a Fractal Outliner (.out) as a new top-level node + page MD.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "action": {
    "default_title": "Clip to Fractal Outliner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "clip-to-fractal": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Clip current page to Fractal"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
